# Copier ce fichier vers .env et adapter les valeurs
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
# Évitez root au quotidien : exécutez securite/creer-utilisateur-app.sql une fois sur le serveur
# MySQL pour créer un compte applicatif à privilèges limités, et utilisez-le ici à la place.
DB_USER=gestpal_app
DB_PASSWORD=motdepasse_mysql
DB_NAME=gestpal
# Obligatoire — le serveur refuse de démarrer si absent. Générez une chaîne aléatoire longue
# (ex. openssl rand -hex 32), jamais une valeur devinable.
SESSION_SECRET=changez_cette_phrase_secrete
# Jeton partagé avec le pont bascule (scale-bridge)
BRIDGE_TOKEN=gestpal-bascule-2026
# true uniquement si un reverse proxy HTTPS est en place devant ce serveur (sinon le cookie de
# session ne serait plus jamais envoyé par le navigateur, qui tourne alors en HTTP).
COOKIE_SECURE=false
